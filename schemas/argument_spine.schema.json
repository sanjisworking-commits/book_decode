{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accordingtologic.local/schemas/argument_spine.schema.json",
  "title": "ArgumentSpine",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book_id",
    "chapter_id",
    "language_modes",
    "nodes"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0", "2.0"] },
    "book_id": { "type": "string", "minLength": 1 },
    "chapter_id": { "type": "string", "minLength": 1 },
    "language_modes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["en", "hinglish"] }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/spineNode" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/spineRelation" }
    },
    "confidence_summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "overall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "notes": { "type": ["string", "null"] }
      }
    },
    "processing": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": ["string", "null"] },
        "prompt_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "created_at": { "type": ["string", "null"], "format": "date-time" },
        "updated_at": { "type": ["string", "null"], "format": "date-time" },
        "token_usage": {
          "type": ["object", "null"],
          "additionalProperties": true
        }
      }
    },
    "validation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "schema_valid": { "type": "boolean" },
        "source_refs_valid": { "type": "boolean" },
        "bilingual_aligned": { "type": "boolean" },
        "relations_valid": { "type": "boolean" },
        "checked_at": { "type": ["string", "null"], "format": "date-time" },
        "mode": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "spineNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "node_type",
        "statement_en",
        "source_status",
        "source_block_ids",
        "order"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "node_type": {
          "type": "string",
          "enum": [
            "chapter_objective",
            "chapter_question",
            "central_claim",
            "organising_idea",
            "supporting_claim",
            "reasoning_step",
            "reasoning_steps",
            "definition",
            "evidence",
            "example",
            "analogy",
            "quotation",
            "evidence_and_examples",
            "assumption",
            "hidden_assumptions",
            "qualification",
            "objection",
            "response",
            "implication",
            "consequence_if_correct",
            "narrative_context",
            "historical_context",
            "transition",
            "tensions_or_gaps",
            "strongest_counter_position",
            "role_in_book",
            "one_sentence_decode",
            "unresolved_question",
            "confidence_and_unresolved",
            "source_block_references"
          ]
        },
        "custom_label": { "type": ["string", "null"] },
        "statement_en": { "type": ["string", "null"] },
        "explanation_en": { "type": ["string", "null"] },
        "statement_hinglish": { "type": ["string", "null"] },
        "explanation_hinglish": { "type": ["string", "null"] },
        "claim_level": { "type": ["string", "null"] },
        "importance": { "type": ["string", "null"] },
        "position_owner": { "type": ["string", "null"] },
        "narrating_voice": { "type": ["string", "null"] },
        "source_status": {
          "type": "string",
          "enum": [
            "explicit_author",
            "author_paraphrase",
            "ai_inference",
            "external_counter",
            "quoted_position",
            "source_based_inference",
            "source_based_objection"
          ]
        },
        "source_block_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scope_qualifiers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "supports_node_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "supports_claim_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "prev_id": { "type": ["string", "null"] },
        "next_id": { "type": ["string", "null"] },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "spineRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_node_id", "to_node_id", "relation_type"],
      "properties": {
        "from_node_id": { "type": "string", "minLength": 1 },
        "to_node_id": { "type": "string", "minLength": 1 },
        "relation_type": {
          "type": "string",
          "enum": [
            "supports",
            "explains",
            "provides_evidence_for",
            "illustrates",
            "defines",
            "qualifies",
            "challenges",
            "responds_to",
            "depends_on",
            "leads_to",
            "contrasts_with",
            "provides_context_for"
          ]
        },
        "explanation_en": { "type": ["string", "null"] },
        "source_block_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
