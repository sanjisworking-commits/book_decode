# According to Logic — Book Decode
# Copy to .env and fill in values. Do not commit real secrets.

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Storage (MVP: local filesystem + SQLite) ---
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
BOOKS_DIR=./data/books
LOG_DIR=./data/logs
SQLITE_PATH=./data/book_decode.db

# --- Upload limits ---
MAX_EPUB_SIZE_MB=50

# --- LLM provider ---
# openai | anthropic | openai_compatible
LLM_PROVIDER=openai
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
# Output budget — full-chapter spines need headroom or JSON gets truncated mid-string
LLM_MAX_TOKENS=16384
# Seconds to wait for each LLM HTTP response (large chapters need more headroom)
LLM_TIMEOUT_SECONDS=300
# Extra attempts after a timeout / connection error
LLM_HTTP_RETRIES=2
# Set true for local/demo runs without calling a real model
LLM_MOCK=false

# Anthropic Claude example:
# LLM_PROVIDER=anthropic
# LLM_API_BASE=https://api.anthropic.com
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-6
# (claude-sonnet-4-20250514 was retired — do not use it)

# OpenAI-compatible gateway example (Groq, Together, Ollama, etc.):
# LLM_PROVIDER=openai_compatible
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
# Groq free llama-3.3-70b TPM ~12k counts prompt + max_tokens.
# Auto-clamps completion (~4.2k) and prompt (~7.3k). Override if needed:
# LLM_MAX_INPUT_TOKENS=6000
# LLM_MAX_TOKENS=4096
# PROTOTYPE_ONE_SHOT=false   # multi-chunk for fuller chapter coverage

# --- Pipeline controls ---
MAX_CHAPTER_RETRIES=3
RETRY_BACKOFF_SECONDS=2
CHUNK_TOKEN_LIMIT=20000
CHUNK_OVERLAP_BLOCKS=2
# Cap *full* extract prompt (system+user). 0 = auto (Groq 70b → TPM − max_tokens).
LLM_MAX_INPUT_TOKENS=0
# Prototype: one LLM call per chapter (EN spine only; skip synth + hinglish)
PROTOTYPE_ONE_SHOT=true

# --- Optional IndicTrans2 comparison layer (not the reasoning engine) ---
INDIC_TRANS2_ENABLED=false
INDIC_TRANS2_ENDPOINT=
